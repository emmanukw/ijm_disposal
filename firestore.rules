rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function settings() {
      return get(/databases/$(database)/documents/settings/auction).data;
    }
    function bookingOpen() {
      let s = settings();
      return request.time < s.endsAt
        && (!('startsAt' in s) || s.startsAt == null || request.time >= s.startsAt);
    }

    // Admin list: only readable by the user themself; managed in the console.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || validBookingUpdate(itemId);
    }

    // A bidder may only decrement `remaining` by the quantity of the bid
    // created in the same transaction (referenced via lastBidId).
    function validBookingUpdate(itemId) {
      let before = resource.data;
      let after = request.resource.data;
      let bidPath = /databases/$(database)/documents/bids/$(after.lastBidId);
      let bid = getAfter(bidPath).data;
      return signedIn()
        && bookingOpen()
        && after.diff(before).affectedKeys().hasOnly(['remaining', 'lastBidId'])
        && !exists(bidPath)
        && existsAfter(bidPath)
        && bid.itemId == itemId
        && after.remaining == before.remaining - bid.quantity
        && after.remaining >= 0;
    }

    match /bids/{bidId} {
      allow read: if true;
      allow create: if signedIn()
        && bookingOpen()
        && request.resource.data.keys().hasOnly(
             ['itemId', 'itemName', 'bidderName', 'quantity', 'unitPrice', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.bidderName is string
        && request.resource.data.bidderName.size() >= 2
        && request.resource.data.bidderName.size() <= 80
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && getAfter(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.lastBidId == bidId;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
